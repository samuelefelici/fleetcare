{
  "name": "@fleetcare/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./domain/*": "./src/domain/*.ts",
    "./ops/*": "./src/ops/*.ts"
  },
  "scripts": {
    "lint": "prettier --check src tests drizzle.config.ts vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/run.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.1",
    "prettier": "^3.5.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
