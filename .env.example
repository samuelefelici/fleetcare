# ============================================================
# FleetCare — variabili d'ambiente
# In produzione le env vars vivono SOLO nella UI di Coolify.
# Copiare in .env per lo sviluppo locale (docker-compose.dev.yml).
# ============================================================

# --- Database (PostgreSQL 17) ---
# Database DEDICATO a FleetCare, non quello di Cerbero: lì lo schema
# "fleetcare" esiste già ed è del modulo TPL (vedi docs/analisi-campi.md §1).
# L'app si connette con `fleetcare_app` (ruolo NON superuser, soggetto a RLS).
DATABASE_URL=postgres://fleetcare_app:fleetcare_app@localhost:5432/fleetcare
# Ruolo owner, usato SOLO da migration e seed (mai dall'app)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/fleetcare

# --- Seed ---
# associazione da creare al primo seed
SEED_TENANT_SLUG=croce-gialla-camerano
SEED_TENANT_NAME="Croce Gialla di Camerano"

# --- Storage documenti (MinIO, S3-compatible) ---
# certificati, fatture, foto delle segnalazioni: bucket privato, solo presigned URL
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fleetcare
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
