# ============================================================
# FleetCare — variabili d'ambiente
# In produzione le env vars vivono SOLO nella UI di Coolify.
# Copiare in .env per lo sviluppo locale (docker-compose.dev.yml).
# ============================================================

# --- Database (PostgreSQL 17) ---
# Database DEDICATO a FleetCare, non quello di Cerbero: lì lo schema
# "fleetcare" esiste già ed è del modulo TPL (vedi docs/analisi-campi.md §1).
# L'app si connette con `fleetcare_app` (ruolo NON superuser, soggetto a RLS).
# All'avvio del container la password del ruolo diventa quella scritta qui
# (src/ops/prepare.ts): in produzione una password vera, di soli caratteri
# ASCII; quella di sviluppo qui sotto il container la rifiuta.
DATABASE_URL=postgres://fleetcare_app:fleetcare_app@localhost:5432/fleetcare
# Ruolo owner, usato SOLO da migration, seed e avvio del container (mai dall'app)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/fleetcare

# --- App web ---
# firma dei cookie di sessione: openssl rand -base64 32
AUTH_SECRET=cambiami-con-openssl-rand-base64-32

# --- Seed ---
# associazione da creare al primo seed (anche all'avvio del container, se
# SEED_TENANT_SLUG c'è; rilanciarlo non fa niente)
SEED_TENANT_SLUG=croce-gialla-camerano
SEED_TENANT_NAME="Croce Gialla di Camerano"
SEED_TENANT_NETWORK=ANPAS
SEED_TENANT_CITY=Camerano
SEED_TENANT_PROVINCE=AN
# la prima utenza della direzione: creata dal container solo se
# l'associazione non ha ancora nessuna utenza; dopo, ignorate
BOOTSTRAP_ADMIN_EMAIL=direzione@example.it
BOOTSTRAP_ADMIN_PASSWORD=cambiami-subito
BOOTSTRAP_ADMIN_NAME="Direzione"

# --- Storage documenti (MinIO, S3-compatible) ---
# certificati, fatture, foto delle segnalazioni: bucket privato, solo presigned URL
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fleetcare
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
