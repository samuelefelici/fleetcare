{
  "name": "fleetcare",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "pnpm --filter @fleetcare/db test:db",
    "db:generate": "pnpm --filter @fleetcare/db db:generate",
    "db:migrate": "pnpm --filter @fleetcare/db db:migrate",
    "db:seed": "pnpm --filter @fleetcare/db db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "~5.8.3"
  }
}
